# SharePoint MCP Server — Example Configuration
# -----------------------------------------------
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# The .env file is in .gitignore — it will NEVER be committed.
# This .env.example file contains only placeholder values and IS committed.

# Debug mode (True/False)
DEBUG=False

# Microsoft Entra ID (Azure AD) — App Registration credentials
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=11111111-1111-1111-1111-111111111111
CLIENT_SECRET=your-client-secret-here

# SharePoint Sites — multi-site configuration
# The first site (SITE_1) acts as the default when no site_name is passed.
SITE_1_NAME=Home
SITE_1_URL=https://yourorg.sharepoint.com/sites/home

# Add more sites as needed:
# SITE_2_NAME=Finance
# SITE_2_URL=https://yourorg.sharepoint.com/sites/finance

# Legacy fallback (used if no SITE_N_URL entries are found)
SITE_URL=https://yourorg.sharepoint.com/sites/home

# User credentials (for username/password auth — not recommended for production)
USERNAME=your.email@example.com
PASSWORD=your_password

# HTTP transport settings (for web/Docker deployment)
# Options: stdio | sse | streamable-http
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
